{
  "name": "sentinelforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelForge - Autonomous IoT Firmware Security & Zero-Day Vulnerability Discovery Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:workers": "npm run dev --workspace=apps/workers",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^1.13.4",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@10.8.2"
}
